{
  "name": "OTPlease",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w server -w worker",
    "test": "npm run test -w server",
    "test:coverage": "npm run test:coverage -w server",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "prettier": "3.9.6",
    "turbo": "^2.11.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
