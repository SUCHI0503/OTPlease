{
  "name": "OTPlease",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w server -w worker"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "3.9.6",
    "turbo": "^2.11.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
