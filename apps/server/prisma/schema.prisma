generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  phone         String
  createdAt     DateTime    @default(now())
  otpCodes      OtpCode[]
  sessions      Session[]

  @@unique([applicationId, phone])
}

model OtpCode {
  id            String      @id @default(uuid())
  applicationId String
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  codeHash      String
  expiresAt     DateTime
  attempts      Int         @default(0)
  maxAttempts   Int         @default(5)
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId, consumedAt])
}

model Session {
  id              String    @id @default(uuid())
  applicationId   String
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  refreshHash     String
  prevRefreshHash String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())

  @@index([userId])
  @@index([applicationId])
}

model Delivery {
  id                String   @id @default(uuid())
  applicationId     String
  requestedChannel  String
  channel           String?
  status            String   @default("queued")
  providerMessageId String?
  toMasked          String
  error             String?
  attempts          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([applicationId])
  @@index([providerMessageId])
}

model ApiKey {
  id            String    @id @default(uuid())
  applicationId String
  name          String
  prefix        String    @unique
  keyHash       String
  scopes        String[]
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?
  revokedAt     DateTime?

  @@index([applicationId])
}

model WebhookEndpoint {
  id            String    @id @default(uuid())
  applicationId String
  url           String
  secretEnc     String
  events        String[]
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([applicationId])
}

model WebhookLog {
  id             String   @id @default(uuid())
  applicationId  String
  endpointId     String
  eventId        String
  type           String
  status         String   @default("pending")
  attempts       Int      @default(0)
  lastStatusCode Int?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([endpointId])
  @@index([applicationId])
}
