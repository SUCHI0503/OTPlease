NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://otplease:otplease@localhost:5432/otplease
# At least 32 characters. Generate: openssl rand -hex 32
OTP_HASH_SECRET=
# Optional: local email via Mailpit (docker compose up mailpit, inbox at http://localhost:8025)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# A real mail service also needs a login (port 587 uses STARTTLS, 465 uses TLS). Gmail: smtp.gmail.com, 587, an app password.
# SMTP_USER=
# SMTP_PASS=
# At least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=
# Redis. Tests use database /1 so they never touch dev data.
REDIS_URL=redis://localhost:6379/0
# Optional: Twilio for SMS, WhatsApp (sandbox) and Voice. Unset = mock provider.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1...
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_VOICE_FROM=+1...
# Public URL of POST /webhooks/twilio/status (e.g. an ngrok URL) for delivery status
# TWILIO_STATUS_CALLBACK_URL=
# Platform operator secret, at least 32 characters. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Local dev only: lets webhooks target localhost. Must be false in production.
# WEBHOOK_ALLOW_PRIVATE_URLS=true

# Behind Nginx or a load balancer: how many proxy hops to trust for the client IP (e.g. 1).
# Leave false otherwise, or clients could fake their IP with X-Forwarded-For and dodge rate limits.
# TRUST_PROXY=false
# Browser origins allowed to call the API directly (exact origins, comma separated, never *).
# Empty means no CORS, which is right when only servers call the API.
# CORS_ORIGINS=https://dashboard.example.com

# Log level: fatal, error, warn, info (default), debug, trace or silent
# LOG_LEVEL=info
# Tune rate limits without a code change (used for load tests). Names: otpRequestPerPhone, otpRequestPerIp,
# otpRequestPerCountry, otpRequestPerApplication, verifyPerPhone, verifyPerIp, refreshPerIp, authFailuresPerIp
# RATE_LIMITS_JSON={"otpRequestPerIp":{"limit":5000,"windowSeconds":600}}
