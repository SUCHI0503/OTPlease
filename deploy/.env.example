# Copy to deploy/.env on the server (bootstrap.sh does this and generates the secrets for you). Never commit deploy/.env.
DOMAIN=staging.example.com        # api.DOMAIN, app.DOMAIN and demo.DOMAIN must all point at this server
DEPLOY_ENV=staging
ALLOW_MOCK_PROVIDERS=true         # staging only: WhatsApp/SMS/voice use the mock until you have a paid Twilio account

# Generated by bootstrap.sh (openssl rand -hex 32)
POSTGRES_PASSWORD=
OTP_HASH_SECRET=
JWT_SECRET=
ADMIN_TOKEN=

# Email must be real, or nobody can receive a code
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OTPlease <you@example.com>

# Real delivery (leave blank on staging while ALLOW_MOCK_PROVIDERS=true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_STATUS_CALLBACK_URL=       # https://api.DOMAIN/webhooks/twilio/status

# Error reporting (optional): a Sentry project DSN
SENTRY_DSN=

BACKUP_BUCKET=                    # the S3 bucket Terraform created
